
# Database Configuration
DATABASE_URL=your_actual_database_url_here
CHROMA_DB_PATH=./chroma_data
DATA_REFRESH_INTERVAL_DAYS=7

# GitHub Models AI Configuration (Handles Matching Rationale & Data Sanitization)
LLM_BASE_URL=https://models.github.ai/inference
LLM_API_KEY=your_actual_github_pat_here
LLM_MODEL_NAME=gpt-4o-mini

# Google AI Studio Ingestion Crawler Engine (Lightning Fast & Free)
GEMINI_API_KEY=your_actual_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# External Scraper Proxy Keys
YOUTUBE_API_KEY=your_actual_youtube_api_key_here
APIFY_TOKEN=your_actual_apify_token_here
APIFY_INSTAGRAM_URL=your_actual_apify_instagram_url_here

